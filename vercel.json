{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "crons": [
    {
      "path": "/api/cron/daily-backup",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "holga-alimi2.vercel.app"
        }
      ],
      "destination": "https://stonelantern.vercel.app/:path*",
      "permanent": true
    }
  ]
}
